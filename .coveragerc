[run]
branch = True
source =
    src
    desktop
    dashboard
    apps/api/app
omit =
    */tests/*
    */test_*.py
    scripts/*
    apps/web/*
    */__pycache__/*
    .venv/*

[report]
skip_empty = True
show_missing = True
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
